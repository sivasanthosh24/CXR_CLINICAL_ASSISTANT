{
  "module_name": "Module 1 - View-Specific Chest X-ray Disease Prediction",
  "project_name": "CXR Clinical AI",
  "export_version": "module1_portable_v1",
  "created_at": "2026-09-10T19:48:52.646804",
  "task": {
    "type": "multilabel_classification",
    "number_of_classes": 14,
    "activation": "sigmoid",
    "probability_range": [
      0.0,
      1.0
    ]
  },
  "class_order": [
    "Enlarged Cardiomediastinum",
    "Cardiomegaly",
    "Lung Opacity",
    "Lung Lesion",
    "Edema",
    "Consolidation",
    "Pneumonia",
    "Atelectasis",
    "Pneumothorax",
    "Pleural Effusion",
    "Pleural Other",
    "Fracture",
    "Support Devices",
    "No Finding"
  ],
  "models": {
    "AP": {
      "architecture": "DenseNet121",
      "checkpoint": "checkpoints/ap_densenet121_best.pth",
      "backbone_frozen": true,
      "classifier_output_dimension": 14,
      "gradcam_target_layer": "features"
    },
    "Lateral": {
      "architecture": "ResNet50",
      "checkpoint": "checkpoints/lateral_resnet50_weighted_best.pth",
      "backbone_frozen": true,
      "classifier_output_dimension": 14,
      "gradcam_target_layer": "features[-1]",
      "training_loss": "weighted_binary_cross_entropy"
    }
  },
  "preprocessing": {
    "image_mode": "RGB",
    "resize": [
      224,
      224
    ],
    "normalization": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    },
    "inference_augmentation": false
  },
  "gradcam": {
    "method": "Grad-CAM",
    "target_output": "selected disease class",
    "normalization": "min-max",
    "default_threshold": 0.5,
    "minimum_component_area": 25,
    "target_layer_AP": "model.features",
    "target_layer_Lateral": "model.features[-1]"
  },
  "weak_localization": {
    "method": "thresholded Grad-CAM activation mask",
    "postprocessing": [
      "binary thresholding",
      "small-component filtering",
      "connected-component extraction",
      "largest-component selection",
      "bounding-box generation"
    ],
    "output_type": "approximate weak-localization bounding box",
    "not_ground_truth_detection": true
  },
  "outputs": {
    "disease_probabilities": true,
    "selected_disease_gradcam": true,
    "activation_mask": true,
    "weak_localization_bounding_box": true
  },
  "evaluation_reference": {
    "dataset": "CXR 10K validation subset",
    "validation_cases": 6,
    "AP_cases": 3,
    "lateral_cases": 3,
    "class_order_verified": true
  }
}